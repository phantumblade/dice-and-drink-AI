// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String // Hashed password
  role      String   @default("customer") // "guest", "customer", "staff", "admin"
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stats
  gamesPlayed  Int     @default(0)
  winRate      Int     @default(0)
  favoriteGame String?
  totalSpent   Float   @default(0)
  xp           Int     @default(0)

  // Relations
  badges                Badge[]
  bookings              Booking[]
  registeredTournaments TournamentParticipant[]

  // D&D Relations
  characters        Character[]
  campaignsOwned    Campaign[]            @relation("DungeonMaster")
  campaignsProposed Campaign[]            @relation("CampaignProposer")
  campaignsJoined   CampaignParticipant[]
  campaignRequests  CampaignRequest[]

  // Tournament Wins
  tournamentsWon Tournament[]   @relation("TournamentWinner")
  notifications  Notification[]
  campaignNotes  CampaignNote[]
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  icon        String
  description String
  dateEarned  DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String @id @default(uuid())
  name        String
  category    String // "game", "drink", "snack"
  description String
  price       Float
  image       String
  tags        String // Stored as JSON string or comma-separated
  rating      Float  @default(0)

  // Specific fields
  players  String?
  duration String?
  alcohol  Boolean?

  cartItems   CartItem[]
  tournaments Tournament[]
}

model Booking {
  id           String     @id @default(uuid())
  date         DateTime
  time         String
  participants Int
  duration     Int // hours
  totalPrice   Float
  status       String     @default("pending") // "confirmed", "pending", "cancelled"
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  quantity  Int
  productId String
  product   Product @relation(fields: [productId], references: [id])
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Tournament {
  id    String   @id @default(uuid())
  title String
  date  DateTime
  type  String // "Standard", "Competitive", "Casual"

  // Relations
  gameId String?
  game   Product? @relation(fields: [gameId], references: [id])

  participants TournamentParticipant[]

  // Competitive Features
  entryFee Float   @default(0)
  prizes   String // JSON description of prizes
  winnerId String?
  winner   User?   @relation("TournamentWinner", fields: [winnerId], references: [id])

  // Display
  image       String
  description String
  rules       String?

  // Status
  slots   Int
  filled  Int    @default(0)
  status  String // "upcoming", "ongoing", "completed", "cancelled"
  deposit Float  @default(0)

  // Legacy fields kept for compatibility if needed, or removed if clean break
  gameSystem String?
  includes   String? // JSON string
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  joinedAt     DateTime   @default(now())

  @@unique([userId, tournamentId])
}

model Campaign {
  id     String @id @default(uuid())
  title  String
  type   String // "ONE_SHOT", "SHORT_CAMPAIGN", "LONG_CAMPAIGN"
  system String // "D&D 5e", "Pathfinder", etc.

  // DM Relation
  dmId String
  dm   User   @relation("DungeonMaster", fields: [dmId], references: [id])

  // Logistics
  startDate DateTime
  frequency String // "Weekly", "Bi-weekly", "Monthly", "One-time"
  status    String // "RECRUITING", "ACTIVE", "PAUSED", "COMPLETED"
  deposit   Float    @default(0)

  // D&D Specifics
  maxPlayers      Int    @default(4)
  currentPlayers  Int    @default(0)
  platform        String @default("In Person")
  sessionDuration String @default("3-4 hours")
  tags            String @default("[]")

  // Content
  image       String
  description String
  rules       String? // DM Rules (markdown)
  plot        String? // Basic Plot/Theme (markdown)
  minPlayers  Int     @default(3)
  levelRange  String // e.g., "1-5", "10+"

  // Proposal System
  isProposal     Boolean @default(false)
  proposalStatus String? // "PENDING", "APPROVED", "DM_ASSIGNED", "READY"
  proposerId     String?
  proposer       User?   @relation("CampaignProposer", fields: [proposerId], references: [id])

  // Relations
  participants CampaignParticipant[]
  requests     CampaignRequest[]
  sessions     Session[]
  notes        CampaignNote[]
}

model Character {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core Info
  name       String
  race       String
  class      String
  level      Int
  background String?
  alignment  String?

  // Stats (JSON for flexibility)
  stats  String // { str: 10, dex: 14, ... }
  skills String // { stealth: +5, ... }

  // Inventory & Status
  inventory String? // JSON list of items
  hp        Int
  maxHp     Int
  status    String // "ALIVE", "DEAD", "RETIRED"

  // Visuals
  avatar String

  // Relations
  campaigns     CampaignParticipant[]
  requests      CampaignRequest[]
  campaignNotes CampaignNote[]
}

model CampaignRequest {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status    String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  message   String? // Optional message to DM
  createdAt DateTime @default(now())
}

model CampaignParticipant {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([campaignId, characterId])
  @@unique([campaignId, userId]) // Enforce 1 character per user per campaign
}

model Session {
  id       String   @id @default(uuid())
  title    String
  date     DateTime
  summary  String
  location String

  // Details
  loot    String? // JSON or text
  enemies String? // JSON or text
  quests  String? // JSON or text
  notes   String? // JSON or text

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignNote {
  id        String   @id @default(uuid())
  title     String? // Optional for chat messages
  content   String
  type      String   @default("CHAT") // "CHAT", "LORE", "NPC", "LOCATION", "LOOT"
  createdAt DateTime @default(now())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Authorship
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "SUCCESS", "ERROR", "INFO"
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
